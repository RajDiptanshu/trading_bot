# ── secrets — NEVER commit ──
.env
.env.*
!.env.example

# ── python ──
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── operational logs (CAUTION: Angel One login-failure exceptions can embed
# cleartext password/TOTP/session tokens in the request/response text — never
# commit logs/, ever) ──
logs/
Algo Trading/recommender/logs/
*.log

# ── regenerable caches / machine-specific runtime state ──
universe_cache/
news_briefs/
backtest_results/*.pkl
option_chain_history.jsonl
agent4_heartbeat.json
heartbeat.json
memory_backups/
.~lock.*

# ── large third-party reference material (linked in README instead) ──
machine-learning-for-trading/
Krono/
Notes/*.pdf
Notes/*.docx
Notes/*.doc
Notes/~$*

# ── large user-provided market-data sets (gigabytes — kept local, never committed) ──
NSE500 Daily and Intraday Stock data/
Nifty 500 (NSE) Stocks Multi-Timeframe Dataset/

# ── one-off paper-book backups/archives (superseded by the two V11 book files) ──
agent4_state.backup-*.json
agent4_state.legacy-*.json
agent4_state.pre-split-backup-*.json

# ── editor / OS ──
.DS_Store
Thumbs.db

# stale editor backups / corrupt artifacts / stray files
*.bak-*
*.corrupt-backup-*.json
/python
