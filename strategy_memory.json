  "agent_instructions": {
    "technical_analyser": {
      "tool": "morning_scan.py",
      "output_format": "json",
      "focus": "Extract score, RSI, MACD, ATR, BB position, strategy type, SL, target for each stock",
      "filter": "Only pass stocks with score >= 9 to next agent. Score is now out of 14 points."
    },
    "news_researcher": {
      "tool": "duckduckgo_search",
      "search_queries": [
        "{stock} NSE news today",
        "{stock} earnings results India",
        "India VIX today",
        "Nifty 50 outlook today",
        "RBI policy news today"
      ],
      "output_format": "sentiment: BULLISH/BEARISH/NEUTRAL, event_flag: EARNINGS/NORMAL/HIGH_RISK"
    },
    "data_analyst": {
      "rule": "Merge tech score with news sentiment. Kill trade if news is BEARISH or event_flag is EARNINGS within 3 days",
      "sector_check": "Enforce sector_limits from this file. Max 1 per sector in final output",
      "output": "Top 3 highest conviction setups only. Never pass more than 3 to Financial Expert."
    },
    "financial_expert": {
      "reads": [
        "strategy_memory.json",
        "paper_trades.json",
        "daily_reports/scan_latest.json"
      ],
      "uses": "decision_matrix from instrument_selection section",
      "calculates": "lot_size = floor(max_risk_per_trade_inr / (entry_price * sl_pct))",
      "output_format": {
        "symbol": "string",
        "direction": "LONG or SHORT",
        "instrument": "ATM_CALL / BULL_CALL_SPREAD / EQUITY / ATM_PUT / IRON_CONDOR / SKIP",
        "entry_price": "float",
        "strike": "int (for options)",
        "expiry": "YYYY-MM-DD",
        "quantity": "int (shares or lots)",
        "stop_loss": "float",
        "target": "float",
        "max_risk_inr": "float",
        "reasoning": "1-2 sentence explanation Claude generates"
      }
    },
    "auto_trader": {
      "tool": "paper_trades.py",
      "action": "Call log_trade() for each order from Financial Expert",
      "skip_if": "circuit_active = true OR instrument = SKIP",
      "confirm_message": "Log entry to decision_log.json after each trade"
    },
    "position_monitor": {
      "run_at": "15:30 IST daily",
      "reads": "paper_trades.json for all OPEN positions",
      "fetches": "live closing price via yfinance",
      "closes_if": "price >= target OR price <= stop_loss OR days_held >= time_stop",
      "updates": "performance_live section of this file after each close"
    },
    "weekly_tuner": {
      "run_at": "18:00 IST every Sunday",
      "model": "claude-opus-4-6",
      "reviews": "All trades from the past week",
      "can_modify": [
        "entry_rules.minimum_score_to_trade",
        "entry_rules.rsi_long_max",
        "entry_rules.rsi_long_min",
        "entry_rules.strategies_enabled",
        "stock_universe.blacklist",
        "stock_universe.high_conviction_favorites",
        "capital_rules.max_risk_per_trade_inr",
        "capital_rules.kelly_params",
        "circuit_breakers",
        "performance_live",
        "weekly_performance_history"
      ],
      "cannot_modify": [
        "meta.deployment_ready",
        "meta.paper_trading_capital",
        "instrument_selection.india_vix_thresholds",
        "portfolio_rules.sector_limits"
      ],
      "must_add_to_changelog": true,
      "format_instruction": "When rewriting any value, explain WHY in weekly_changelog entry. Be specific: quote the trades that caused the change."
    }
  },
