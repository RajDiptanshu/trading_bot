# Copy this file to .env and fill in your own values. NEVER commit the real .env.

# Claude (Agent 3 strategist, Agent 6 news brain, Agent 5 EOD narrative)
ANTHROPIC_API_KEY=

# Angel One SmartAPI (live quotes, historical candles, option chain, order routing)
# Get these from https://smartapi.angelbroking.com after opening an Angel One account.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Telegram alerts (optional — kill-switch / watchdog notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (defaults shown)
# AGENT4_UNIVERSE_SCOPE=nifty210      # core | nifty50 | nifty210 | nifty500
# AGENT4_TOP_N_RECS=5                 # Claude calls per entry cycle (speed/cost lever)
# AGENT4_MAX_POSITIONS=12
# AGENT4_MAX_HEAT_PCT=8.0
# AGENT4_MAX_OPTION_POS=5
# NEWS_LOOKBACK_HOURS=24
# NEWS_MAX_AGE_HOURS=48
# TRADING_BOT_DIR=C:\trading_bot      # override if installing elsewhere
